<style>
/* ── Visit Modal ── */
#visit-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.65);
    z-index: 9999;
    overflow-y: auto;
    padding: 24px 16px;
    align-items: flex-start;
    justify-content: center;
}
#visit-modal-overlay.active { display: flex; }
#visit-modal-card {
    background: #fff;
    border-radius: 16px;
    padding: 40px;
    max-width: 560px;
    width: 100%;
    position: relative;
    margin: auto;
}

/* ── Modal Mailchimp form ── */
#mc_embed_visit { background: transparent !important; clear: left; width: 100%; }
#mc_embed_visit .mc-field-group { padding-bottom: 14px; width: 100%; min-height: unset; }
#mc_embed_visit .mc-field-group label {
    display: block;
    margin-bottom: 6px;
    color: #1B2A4A;
    font-weight: 600;
    font-size: 14px;
    font-family: 'Lato', sans-serif;
}
#mc_embed_visit input[type="text"],
#mc_embed_visit input[type="email"],
#mc_embed_visit select {
    width: 100%;
    padding: 12px;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background: #fff;
    font-size: 14px;
    box-sizing: border-box;
    font-family: 'Lato', sans-serif;
    color: #333;
    appearance: auto;
}
#mc_embed_visit input[type="text"]:focus,
#mc_embed_visit input[type="email"]:focus,
#mc_embed_visit select:focus { outline: none; border-color: #E8541A; box-shadow: 0 0 0 2px rgba(232,84,26,0.12); }
#mc_embed_visit .clear { padding-top: 8px; }
#mc_embed_visit input.button {
    width: 100%;
    padding: 14px;
    background: #E8541A !important;
    color: #fff !important;
    border: none !important;
    border-radius: 50px;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.2s;
    font-family: 'Lato', sans-serif;
}
#mc_embed_visit input.button:hover { background: #C04E25 !important; }
#mc_embed_visit #mce-responses-v { display: none; }
#mc_embed_visit .asterisk { color: #E8541A; }
#mc_embed_visit h2 { display: none !important; }

/* ── FAQ icon (shared with pages that have FAQs) ── */
.faq-icon { transition: transform 0.2s ease; }
</style>

<!-- Plan Your Visit Modal -->
<div id="visit-modal-overlay" onclick="handleOverlayClick(event)">
    <div id="visit-modal-card">
        <button onclick="closeVisitModal()" style="position:absolute;top:16px;right:20px;font-size:28px;line-height:1;color:#9ca3af;background:none;border:none;cursor:pointer;padding:0;" aria-label="Close">&times;</button>
        <h2 class="font-anton text-3xl uppercase tracking-h2 mb-2" style="color:#1B2A4A;">Plan Your Visit</h2>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">We would love to know you are coming. Fill out this short form and we will make sure you are welcomed when you arrive.</p>

        <link href="//cdn-images.mailchimp.com/embedcode/classic-061523.css" rel="stylesheet" type="text/css">
        <div id="mc_embed_visit">
            <form action="https://mercycourt.us2.list-manage.com/subscribe/post?u=1f6d34239bf35c1b0512b77c8&amp;id=888af1f4b9&amp;f_id=0065c5e1f0" method="post" id="mc-visit-plan-form" name="mc-visit-plan-form" class="validate" target="_blank">
                <div id="mc_visit_signup_scroll">
                    <div class="mc-field-group">
                        <label for="mce-FNAME-v">First Name <span class="asterisk">*</span></label>
                        <input type="text" name="FNAME" class="required text" id="mce-FNAME-v" required value="">
                    </div>
                    <div class="mc-field-group">
                        <label for="mce-LNAME-v">Last Name</label>
                        <input type="text" name="LNAME" class="text" id="mce-LNAME-v" value="">
                    </div>
                    <div class="mc-field-group">
                        <label for="mce-EMAIL-v">Email Address <span class="asterisk">*</span></label>
                        <input type="email" name="EMAIL" class="required email" id="mce-EMAIL-v" required value="">
                    </div>
                    <div class="mc-field-group">
                        <label for="mce-PHONE-v">Phone Number</label>
                        <input type="text" name="PHONE" id="mce-PHONE-v" value="">
                    </div>
                    <div class="mc-field-group">
                        <label for="mce-service-v">Which service are you planning to attend?</label>
                        <select name="service_preference" id="mce-service-v">
                            <option value="">No preference</option>
                            <option value="9:30 AM – 1st Service">{{ site.service_times.sunday_1.time }} – {{ site.service_times.sunday_1.label }}</option>
                            <option value="12:00 PM – 2nd Service">{{ site.service_times.sunday_2.time }} – {{ site.service_times.sunday_2.label }}</option>
                        </select>
                    </div>
                    <div class="mc-field-group">
                        <label for="mce-MMERGE10-v">Anything you'd like us to know?</label>
                        <input type="text" name="MMERGE10" class="text" id="mce-MMERGE10-v" value="">
                    </div>
                    <div class="mc-field-group">
                        <label for="mce-group-hear">How did you hear about us?</label>
                        <select name="group[10562]" id="mce-group-hear">
                            <option value=""></option>
                            <option value="1">Friend or Family</option>
                            <option value="2">Social Media</option>
                            <option value="4">Google Search</option>
                            <option value="8">Drove Past the Church</option>
                            <option value="16">Other</option>
                        </select>
                    </div>
                    <div class="mc-field-group">
                        <label for="mce-group-with">Are you coming with friend(s) or family?</label>
                        <select name="group[10563]" id="mce-group-with">
                            <option value=""></option>
                            <option value="32">Just me</option>
                            <option value="64">With a friend</option>
                            <option value="128">With my spouse</option>
                            <option value="256">With family and/or children</option>
                        </select>
                    </div>
                    <div hidden><input type="hidden" name="tags" value="5993"></div>
                    <div id="mce-responses-v">
                        <div id="mce-error-response-v" style="display:none;"></div>
                        <div id="mce-success-response-v" style="display:none;"></div>
                    </div>
                    <div aria-hidden="true" style="position:absolute;left:-5000px;">
                        <input type="text" name="b_1f6d34239bf35c1b0512b77c8_888af1f4b9" tabindex="-1" value="">
                    </div>
                    <div class="clear">
                        <input type="submit" name="subscribe" id="mc-visit-submit" class="button" value="Plan My Visit">
                    </div>
                </div>
            </form>
        </div>
        <div id="plan-visit-success" style="display:none; text-align:center; padding:40px 20px;">
            <p style="font-size:20px; color:#1B2A4A; font-weight:bold;">Thank you! We are so excited to meet you. See you Sunday at {{ site.address_street }}, {{ site.address_city_state }}. Services begin at {{ site.service_times.sunday_1.time }} and {{ site.service_times.sunday_2.time }} ({{ site.service_times.sunday_1.time }} only on the first Sunday of the month).</p>
        </div>
    </div>
</div>

<script>
    function openVisitModal() {
        document.getElementById('visit-modal-overlay').classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function closeVisitModal() {
        document.getElementById('visit-modal-overlay').classList.remove('active');
        document.body.style.overflow = '';
        document.getElementById('mc_visit_signup_scroll').style.display = '';
        document.getElementById('plan-visit-success').style.display = 'none';
        document.getElementById('mc-visit-plan-form').reset();
    }
    function handleOverlayClick(e) {
        if (e.target === document.getElementById('visit-modal-overlay')) closeVisitModal();
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeVisitModal();
    });

    document.getElementById('mc-visit-plan-form').addEventListener('submit', function(e) {
        e.preventDefault();

        var fname = document.getElementById('mce-FNAME-v').value;
        var lname = document.getElementById('mce-LNAME-v').value;
        var email = document.getElementById('mce-EMAIL-v').value;
        var phone = document.getElementById('mce-PHONE-v').value;
        var message = document.getElementById('mce-MMERGE10-v').value;
        var servicePreference = document.querySelector('#mc-visit-plan-form [name="service_preference"]').value;
        var howDidYouHear = document.querySelector('#mc-visit-plan-form [name="group[10562]"]').value;
        var comingWith = document.querySelector('#mc-visit-plan-form [name="group[10563]"]').value;

        // Step 1 — Submit to Formspree; fire conversion events only on confirmed success
        fetch('https://formspree.io/f/xreddnbn', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
                firstName: fname,
                lastName: lname,
                email: email,
                phone: phone,
                servicePreference: servicePreference,
                message: message,
                howDidYouHear: howDidYouHear,
                comingWith: comingWith
            })
        }).then(function(resp) {
            if (resp.ok) {
                if (typeof fbq === 'function') {
                    fbq('track', 'Lead', { content_name: 'plan_your_visit' });
                }
                if (typeof gtag === 'function') {
                    gtag('event', 'generate_lead', {
                        form: 'plan_your_visit',
                        service: servicePreference || 'No preference'
                    });
                }
            }
        }).catch(function(){});

        // Step 2 — Submit to Mailchimp via JSONP
        var cbName = 'mc_cb_' + Date.now();
        var params = new URLSearchParams({
            'FNAME': fname,
            'LNAME': lname,
            'EMAIL': email,
            'PHONE': phone,
            'MMERGE10': message,
            'group[10562]': howDidYouHear,
            'group[10563]': comingWith,
            'tags': '5993',
            'b_1f6d34239bf35c1b0512b77c8_888af1f4b9': '',
            'c': cbName
        });
        window[cbName] = function() {
            delete window[cbName];
            if (script.parentNode) script.parentNode.removeChild(script);
        };
        var script = document.createElement('script');
        script.src = 'https://mercycourt.us2.list-manage.com/subscribe/post-json?u=1f6d34239bf35c1b0512b77c8&id=888af1f4b9&f_id=0065c5e1f0&' + params.toString();
        document.body.appendChild(script);

        // Step 3 — Show success message
        document.getElementById('mc_visit_signup_scroll').style.display = 'none';
        document.getElementById('plan-visit-success').style.display = 'block';
    });
</script>
