<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ seo_description }}">
    <link rel="canonical" href="https://mercycourt.org{{ page.url | cleanUrl }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="RCCG Mercy Court">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ seo_description }}">
    <meta property="og:url" content="https://mercycourt.org{{ page.url | cleanUrl }}">
    <meta property="og:image" content="https://mercycourt.org{{ og_image }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ seo_description }}">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-red': '#D95A2B',
                        'brand-dark': '#0A0A0A',
                        'brand-footer': '#1a1a1a',
                    },
                    fontFamily: {
                        'anton': ['Anton', 'sans-serif'],
                        'lato': ['Lato', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <script id="mcjs">!function(c,h,i,m,p){m=c.createElement(h),p=c.getElementsByTagName(h)[0],m.async=1,m.src=i,p.parentNode.insertBefore(m,p)}(document,"script","https://chimpstatic.com/mcjs-connected/js/users/1f6d34239bf35c1b0512b77c8/08dc922941bacce45fba209ed.js");</script>
    <style>
        #visit-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.65);
            z-index: 9999;
            overflow-y: auto;
            padding: 24px 16px;
            align-items: flex-start;
            justify-content: center;
        }
        #visit-modal-overlay.active { display: flex; }
        #visit-modal-card {
            background: #fff;
            border-radius: 16px;
            padding: 40px;
            max-width: 560px;
            width: 100%;
            position: relative;
            margin: auto;
        }
        #mc_embed_visit { background: transparent !important; clear: left; width: 100%; }
        #mc_embed_visit .mc-field-group { padding-bottom: 14px; width: 100%; min-height: unset; }
        #mc_embed_visit .mc-field-group label {
            display: block; margin-bottom: 6px; color: #1B2A4A; font-weight: 600; font-size: 14px; font-family: 'Lato', sans-serif;
        }
        #mc_embed_visit input[type="text"],
        #mc_embed_visit input[type="email"],
        #mc_embed_visit select {
            width: 100%; padding: 12px; border: 1px solid #E0E0E0; border-radius: 8px; background: #fff; font-size: 14px; box-sizing: border-box; font-family: 'Lato', sans-serif; color: #333; appearance: auto;
        }
        #mc_embed_visit input[type="text"]:focus,
        #mc_embed_visit input[type="email"]:focus,
        #mc_embed_visit select:focus { outline: none; border-color: #E8541A; box-shadow: 0 0 0 2px rgba(232,84,26,0.12); }
        #mc_embed_visit .clear { padding-top: 8px; }
        #mc_embed_visit input.button {
            width: 100%; padding: 14px; background: #E8541A !important; color: #fff !important; border: none !important; border-radius: 50px; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; transition: background 0.2s; font-family: 'Lato', sans-serif;
        }
        #mc_embed_visit input.button:hover { background: #C04E25 !important; }
        #mc_embed_visit #mce-responses-v { display: none; }
        #mc_embed_visit .asterisk { color: #E8541A; }
        #mc_embed_visit h2 { display: none !important; }
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }
        .scroll-bounce { animation: bounce 2s infinite; }
        .feature-card { transition: transform 0.25s ease, box-shadow 0.25s ease; }
        .feature-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(0,0,0,0.1); }
        .quote-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .quote-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.15); }
        [id] { scroll-margin-top: 80px; }
    </style>
