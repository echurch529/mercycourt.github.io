<body class="font-lato bg-white text-gray-900">

    <!-- Navigation -->
    {% include "nav.njk" %}

    {%- if status == "past" -%}
    <div class="bg-amber-50 border-b border-amber-200 text-center px-6" style="padding-top: calc(72px + 1rem); padding-bottom: 1rem;">
        <p class="text-amber-800 font-semibold text-sm leading-relaxed">
            This event has passed.
            {%- set activeEvents = collections.eventPages | whereData("status", "active") -%}
            {%- if activeEvents | length %}
            See our current event{% if activeEvents | length > 1 %}s{% endif %}:
            {% for ev in activeEvents %}<a href="/events/{{ ev.data.slug }}" class="underline hover:text-amber-900 transition">{{ ev.data.nav_label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.
            {%- else %}
            <a href="/events/" class="underline hover:text-amber-900 transition">See all events</a>.
            {%- endif %}
        </p>
    </div>
    {%- endif -%}

    <!-- Hero: two modes. Text mode (badge/headline/subheadline present) overlays
         text on a full-bleed background photo. Flyer mode (all hero text blank)
         shows the image itself as the centerpiece — used when the artwork
         already carries the theme, dates, and schedule. -->
    {% if hero.badge or hero.headline or hero.subheadline %}
    <section class="relative overflow-hidden" style="height: 100vh; padding-top: 72px;">
        <div class="absolute inset-0">
            <img loading="lazy" src="{{ hero.image }}" alt="{{ hero.image_alt | default(title) }}" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/50 to-black/20"></div>
        </div>
        <div class="relative z-10 h-full flex flex-col items-center justify-center px-6 text-center">
            {% if hero.badge %}
            <span class="inline-block text-white px-6 py-2 rounded-full text-xs font-bold uppercase tracking-widest mb-8" style="background: #E8541A;">{{ hero.badge }}</span>
            {% endif %}
            <h1 class="font-anton text-5xl md:text-7xl lg:text-8xl uppercase text-white tracking-h1 leading-tight mb-8">
                {{ hero_headline if hero_headline else hero.headline }}
            </h1>
            <p class="text-white/90 text-lg md:text-xl leading-relaxed mb-12" style="max-width: 600px;">
                {{ hero.subheadline }}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                {% if status != "past" %}
                {% if hero.primary_cta_url %}
                <a href="{{ hero.primary_cta_url }}" download class="text-white px-10 py-4 rounded-full font-bold uppercase text-sm tracking-wide inline-block transition-all" style="background: #E8541A;" onmouseover="this.style.background='#C04E25'" onmouseout="this.style.background='#E8541A'">
                    {{ hero.primary_cta if hero.primary_cta else "SAVE THE DATE" }}
                </a>
                {% else %}
                <button onclick="openVisitModal()" class="text-white px-10 py-4 rounded-full font-bold uppercase text-sm tracking-wide cursor-pointer border-0 transition-all" style="background: #E8541A;" onmouseover="this.style.background='#C04E25'" onmouseout="this.style.background='#E8541A'">
                    {{ hero.primary_cta if hero.primary_cta else "PLAN MY VISIT" }}
                </button>
                {% endif %}
                {% endif %}
                {% if hero.secondary_cta_text %}
                    {% if hero.secondary_cta_url == "#visit-modal" %}
                    {% if status != "past" %}
                    <button onclick="openVisitModal()" class="border-2 border-white text-white px-10 py-4 rounded-full font-bold uppercase text-sm hover:bg-white hover:text-black transition tracking-wide cursor-pointer bg-transparent">
                        {{ hero.secondary_cta_text }}
                    </button>
                    {% endif %}
                    {% else %}
                    <a href="{{ hero.secondary_cta_url }}"{% if ".ics" in hero.secondary_cta_url %} download{% endif %} class="border-2 border-white text-white px-10 py-4 rounded-full font-bold uppercase text-sm hover:bg-white hover:text-black transition tracking-wide">
                        {{ hero.secondary_cta_text }}
                    </a>
                    {% endif %}
                {% endif %}
            </div>
        </div>
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 scroll-bounce">
            <svg class="w-8 h-8 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
        </div>
    </section>
    {% else %}
    <section style="background: #0A0A0A; padding-top: 72px;">
        <h1 class="sr-only">{{ hero_headline if hero_headline else title }}</h1>
        <img src="{{ hero.image }}" alt="{{ hero.image_alt | default(title) }}" class="w-full h-auto block">
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center px-6 py-10">
            {% if status != "past" %}
            {% if hero.primary_cta_url %}
            <a href="{{ hero.primary_cta_url }}" download class="text-white px-10 py-4 rounded-full font-bold uppercase text-sm tracking-wide inline-block transition-all" style="background: #E8541A;" onmouseover="this.style.background='#C04E25'" onmouseout="this.style.background='#E8541A'">
                {{ hero.primary_cta if hero.primary_cta else "SAVE THE DATE" }}
            </a>
            {% else %}
            <button onclick="openVisitModal()" class="text-white px-10 py-4 rounded-full font-bold uppercase text-sm tracking-wide cursor-pointer border-0 transition-all" style="background: #E8541A;" onmouseover="this.style.background='#C04E25'" onmouseout="this.style.background='#E8541A'">
                {{ hero.primary_cta if hero.primary_cta else "PLAN MY VISIT" }}
            </button>
            {% endif %}
            {% endif %}
            {% if hero.secondary_cta_text %}
                {% if hero.secondary_cta_url == "#visit-modal" %}
                {% if status != "past" %}
                <button onclick="openVisitModal()" class="border-2 border-white text-white px-10 py-4 rounded-full font-bold uppercase text-sm hover:bg-white hover:text-black transition tracking-wide cursor-pointer bg-transparent">
                    {{ hero.secondary_cta_text }}
                </button>
                {% endif %}
                {% else %}
                <a href="{{ hero.secondary_cta_url }}"{% if ".ics" in hero.secondary_cta_url %} download{% endif %} class="border-2 border-white text-white px-10 py-4 rounded-full font-bold uppercase text-sm hover:bg-white hover:text-black transition tracking-wide">
                    {{ hero.secondary_cta_text }}
                </a>
                {% endif %}
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- Countdown Timer Section (optional: hidden when countdown_target blank) -->
    {% if countdown_target and status != "past" %}
    <section class="py-20 px-6 text-center" style="background: #0A0A0A;">
        <div class="container mx-auto max-w-4xl">
            {% if countdown_heading %}
            <h2 class="font-anton text-3xl md:text-4xl uppercase text-white tracking-h2 mb-12">{{ countdown_heading }}</h2>
            {% endif %}
            <div id="event-countdown" data-target="{{ countdown_target.toISOString() if countdown_target.toISOString else countdown_target }}" class="grid grid-cols-4 gap-4 md:gap-8 max-w-3xl mx-auto">
                <div>
                    <div class="font-anton text-4xl md:text-6xl leading-none" style="color: #E8541A;" data-unit="days">&ndash;</div>
                    <div class="text-white/70 uppercase text-xs md:text-sm tracking-widest mt-3">Days</div>
                </div>
                <div>
                    <div class="font-anton text-4xl md:text-6xl leading-none" style="color: #E8541A;" data-unit="hours">&ndash;</div>
                    <div class="text-white/70 uppercase text-xs md:text-sm tracking-widest mt-3">Hours</div>
                </div>
                <div>
                    <div class="font-anton text-4xl md:text-6xl leading-none" style="color: #E8541A;" data-unit="minutes">&ndash;</div>
                    <div class="text-white/70 uppercase text-xs md:text-sm tracking-widest mt-3">Minutes</div>
                </div>
                <div>
                    <div class="font-anton text-4xl md:text-6xl leading-none" style="color: #E8541A;" data-unit="seconds">&ndash;</div>
                    <div class="text-white/70 uppercase text-xs md:text-sm tracking-widest mt-3">Seconds</div>
                </div>
            </div>
        </div>
    </section>
    <script>
        (function () {
            var el = document.getElementById('event-countdown');
            if (!el) return;
            var target = new Date(el.getAttribute('data-target')).getTime();
            if (isNaN(target)) return;
            var units = {
                days: el.querySelector('[data-unit="days"]'),
                hours: el.querySelector('[data-unit="hours"]'),
                minutes: el.querySelector('[data-unit="minutes"]'),
                seconds: el.querySelector('[data-unit="seconds"]')
            };
            function pad(n) { return n < 10 ? '0' + n : '' + n; }
            var timer;
            function tick() {
                var diff = target - Date.now();
                if (diff <= 0) {
                    units.days.textContent = '0';
                    units.hours.textContent = '00';
                    units.minutes.textContent = '00';
                    units.seconds.textContent = '00';
                    if (timer) clearInterval(timer);
                    return;
                }
                units.days.textContent = Math.floor(diff / 86400000);
                units.hours.textContent = pad(Math.floor(diff / 3600000) % 24);
                units.minutes.textContent = pad(Math.floor(diff / 60000) % 60);
                units.seconds.textContent = pad(Math.floor(diff / 1000) % 60);
            }
            tick();
            timer = setInterval(tick, 1000);
        })();
    </script>
    {% endif %}

    <!-- Testimonials / Social Proof Section (optional) -->
    {% if testimonials and testimonials.heading %}
    <section class="py-24 px-6" style="background: #1B2A4A;">
        <div class="container mx-auto max-w-5xl text-center">
            <span class="inline-block text-white px-6 py-2 rounded-full text-xs font-bold uppercase tracking-widest mb-8" style="background: #E8541A;">STORIES</span>
            <h2 class="font-anton text-4xl md:text-5xl uppercase tracking-h2 text-white mb-4">{{ testimonials.heading }}</h2>
            {% if testimonials.subheading %}
            <p class="text-white/70 text-lg mb-16">{{ testimonials.subheading }}</p>
            {% endif %}
            <div class="mx-auto mb-16" style="max-width: 700px;">
                {% if testimonials.video_url %}
                <div class="relative rounded-2xl overflow-hidden" style="aspect-ratio: 16/9;">
                    <iframe src="{{ testimonials.video_url }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="w-full h-full"></iframe>
                </div>
                {% else %}
                <div class="relative rounded-2xl overflow-hidden flex items-center justify-center" style="background: #0F1E35; aspect-ratio: 16/9;">
                    <div class="flex flex-col items-center gap-4">
                        <div class="w-20 h-20 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.12); border: 2px solid rgba(255,255,255,0.25);">
                            <svg class="w-10 h-10 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        </div>
                    </div>
                </div>
                <p class="text-gray-500 italic text-sm mt-4">Video testimonial coming soon</p>
                {% endif %}
            </div>
            {% if testimonials.quotes and testimonials.quotes.length %}
            {% set quoteCount = testimonials.quotes | length %}
            <div class="grid {% if quoteCount == 1 %}max-w-md mx-auto{% elif quoteCount == 2 %}md:grid-cols-2{% else %}md:grid-cols-3{% endif %} gap-6 text-left">
                {% for q in testimonials.quotes %}
                <div class="quote-card bg-white rounded-2xl p-8 shadow-lg">
                    <div class="text-4xl font-black mb-4 leading-none" style="color: #E8541A;">"</div>
                    <p class="text-gray-700 leading-relaxed mb-8 italic">{{ q.quote }}</p>
                    <p class="font-bold text-sm" style="color: #E8541A;">— {{ q.attribution }}</p>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- Welcome / Message Section (optional) -->
    {% if welcome and welcome.heading %}
    <section class="bg-white py-24 px-6">
        <div class="container mx-auto text-center" style="max-width: 800px;">
            {% if welcome.badge %}
            <span class="inline-block text-white px-6 py-2 rounded-full text-xs font-bold uppercase tracking-widest mb-8" style="background: #E8541A;">{{ welcome.badge }}</span>
            {% endif %}
            <h2 class="font-anton text-4xl md:text-5xl uppercase mb-10 tracking-h2" style="color: #1B2A4A;">{{ welcome.heading }}</h2>
            {% for paragraph in welcome.body %}
            {% for subpara in paragraph | split('\n') %}{% if subpara | trim %}
            <p class="text-gray-600 text-lg leading-relaxed mb-6 text-left">{{ subpara | trim }}</p>
            {% endif %}{% endfor %}
            {% endfor %}
            {% if status != "past" %}
            <button onclick="openVisitModal()" class="text-white px-12 py-4 rounded-full font-bold uppercase text-sm tracking-wide cursor-pointer border-0 transition-all mt-8" style="background: #E8541A;" onmouseover="this.style.background='#C04E25'" onmouseout="this.style.background='#E8541A'">
                PLAN MY VISIT
            </button>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- Event Schedule Section (optional: hidden when no schedule items) -->
    {% if schedule and schedule.items and schedule.items.length %}
    <section class="py-24 px-6" style="background: #F5F5F5;">
        <div class="container mx-auto max-w-6xl">
            <div class="text-center mb-16">
                {% if schedule.badge %}
                <span class="inline-block text-white px-6 py-2 rounded-full text-xs font-bold uppercase tracking-widest mb-8" style="background: #E8541A;">{{ schedule.badge }}</span>
                {% endif %}
                {% if schedule.heading %}
                <h2 class="font-anton text-4xl md:text-5xl uppercase tracking-h2" style="color: #1B2A4A;">{{ schedule.heading }}</h2>
                {% endif %}
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                {% for item in schedule.items %}
                <div class="feature-card bg-white rounded-2xl p-8 shadow-sm text-center flex flex-col">
                    <p class="font-bold text-xs uppercase tracking-widest mb-3" style="color: #E8541A;">{{ item.day }}</p>
                    <h3 class="font-anton text-2xl uppercase leading-tight mb-4" style="color: #1B2A4A;">{{ item.label }}</h3>
                    <p class="text-gray-600 mt-auto">{{ item.time }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Guest Speaker Spotlight Section (optional: hidden when speaker name blank) -->
    {% if speaker and speaker.full_name %}
    <section class="bg-white py-24 px-6">
        <div class="container mx-auto max-w-5xl">
            <div class="text-center mb-16">
                <span class="inline-block text-white px-6 py-2 rounded-full text-xs font-bold uppercase tracking-widest" style="background: #E8541A;">GUEST MINISTER</span>
            </div>
            <div class="grid {% if speaker.photo %}md:grid-cols-2{% endif %} gap-12 items-center">
                {% if speaker.photo %}
                <img loading="lazy" src="{{ speaker.photo }}" alt="{{ speaker.photo_alt | default(speaker.full_name) }}" class="rounded-2xl w-full object-cover shadow-lg">
                {% endif %}
                <div class="{% if not speaker.photo %}text-center max-w-2xl mx-auto{% endif %}">
                    <h2 class="font-anton text-3xl md:text-4xl uppercase tracking-h2 mb-3" style="color: #1B2A4A;">{{ speaker.full_name }}</h2>
                    {% if speaker.title %}
                    <p class="font-bold text-sm uppercase tracking-wide mb-6" style="color: #E8541A;">{{ speaker.title }}</p>
                    {% endif %}
                    {% if speaker.bio %}
                    {% for para in speaker.bio | split('\n') %}{% if para | trim %}
                    <p class="text-gray-600 text-lg leading-relaxed mb-4 text-left">{{ para | trim }}</p>
                    {% endif %}{% endfor %}
                    {% endif %}
                    {% if host_name %}
                    <p class="text-gray-500 text-sm mt-8">Hosted by <span class="font-bold" style="color: #1B2A4A;">{{ host_name }}</span></p>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Feature Cards Section (optional) -->
    {% if features and features.cards and features.cards.length %}
    <section class="py-24 px-6" style="background: #F5F5F5;">
        <div class="container mx-auto max-w-5xl">
            <div class="text-center mb-16">
                {% if features.badge %}
                <span class="inline-block text-white px-6 py-2 rounded-full text-xs font-bold uppercase tracking-widest mb-8" style="background: #E8541A;">{{ features.badge }}</span>
                {% endif %}
                {% if features.heading %}
                <h2 class="font-anton text-4xl md:text-5xl uppercase tracking-h2" style="color: #1B2A4A;">{{ features.heading }}</h2>
                {% endif %}
            </div>
            <div class="grid md:grid-cols-2 gap-8">
                {% for card in features.cards %}
                <div class="feature-card bg-white rounded-2xl p-10 shadow-sm">
                    <div class="text-5xl mb-6">{{ card.emoji }}</div>
                    <h3 class="font-anton text-2xl uppercase mb-4" style="color: #1B2A4A;">{{ card.title }}</h3>
                    <p class="text-gray-600 leading-relaxed">{{ card.body }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Service Logistics Section (optional) -->
    {% if logistics and logistics.heading %}
    <section class="py-24 px-6 text-center" style="background: #E8541A;">
        <div class="container mx-auto max-w-4xl">
            <h2 class="font-anton text-4xl md:text-5xl uppercase text-white tracking-h2 mb-16">{{ logistics.heading }}</h2>
            <div class="grid md:grid-cols-3 gap-10 mb-16">
                <div>
                    <div class="text-5xl mb-5">📍</div>
                    <h3 class="font-bold text-white text-lg uppercase tracking-wide mb-3">Location</h3>
                    <p class="text-white/90 leading-relaxed">{{ site.address_street }}<br>{{ site.address_city_state }}</p>
                </div>
                <div>
                    {% if logistics.middle_label %}
                    <div class="text-5xl mb-5">{{ logistics.middle_icon if logistics.middle_icon else "🗓️" }}</div>
                    <h3 class="font-bold text-white text-lg uppercase tracking-wide mb-3">{{ logistics.middle_label }}</h3>
                    <p class="text-white/90 leading-relaxed">{{ logistics.middle_line1 }}{% if logistics.middle_line2 %}<br>{{ logistics.middle_line2 }}{% endif %}</p>
                    {% else %}
                    <div class="text-5xl mb-5">🕙</div>
                    <h3 class="font-bold text-white text-lg uppercase tracking-wide mb-3">{{ site.service_times.sunday.label }}</h3>
                    <p class="text-white/90 leading-relaxed">{{ site.service_times.sunday.time }}<br>Every Sunday</p>
                    {% endif %}
                </div>
                <div>
                    <div class="text-5xl mb-5">🅿️</div>
                    <h3 class="font-bold text-white text-lg uppercase tracking-wide mb-3">Parking</h3>
                    <p class="text-white/90 leading-relaxed">Free parking<br>Available on site</p>
                </div>
            </div>
            {% if logistics.custom_note %}
            <p class="text-white/90 text-base mb-8">{{ logistics.custom_note }}</p>
            {% endif %}
            {% if status != "past" %}
            <button onclick="openVisitModal()" class="bg-white font-bold uppercase text-sm px-14 py-5 rounded-full tracking-wide cursor-pointer transition hover:bg-gray-100 border-0" style="color: #E8541A;">
                PLAN MY VISIT
            </button>
            {% endif %}
            {% if status != "past" %}
            <p class="text-white/80 text-sm mt-6">It takes less than a minute. Our team will make sure you are welcomed.</p>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- Giving / Donation Section (optional) -->
    {% if giving and giving.heading %}
    <section class="bg-white py-24 px-6 text-center">
        <div class="container mx-auto" style="max-width: 700px;">
            <h2 class="font-anton text-4xl md:text-5xl uppercase tracking-h2 mb-10" style="color: #1B2A4A;">{{ giving.heading }}</h2>
            {% if giving.body %}
            <p class="text-gray-600 text-lg leading-relaxed mb-14">{{ giving.body }}</p>
            {% endif %}
            <a href="{{ giving.url }}" class="text-white px-14 py-5 rounded-full font-bold uppercase text-sm tracking-wide inline-block transition-all" style="background: #E8541A;" onmouseover="this.style.background='#C04E25'" onmouseout="this.style.background='#E8541A'">
                {{ giving.button_text if giving.button_text else "Give Now" }}
            </a>
        </div>
    </section>
    {% endif %}

    <!-- Final CTA Section (optional) -->
    {% if cta_final and cta_final.heading %}
    <section class="bg-white py-24 px-6 text-center">
        <div class="container mx-auto" style="max-width: 700px;">
            <h2 class="font-anton text-4xl md:text-5xl uppercase tracking-h2 mb-10" style="color: #1B2A4A;">{{ cta_final.heading }}</h2>
            {% for paragraph in cta_final.body %}
            <p class="text-gray-600 text-lg leading-relaxed mb-5">{{ paragraph }}</p>
            {% endfor %}
            {% if status != "past" %}
            <button onclick="openVisitModal()" class="text-white px-14 py-5 rounded-full font-bold uppercase text-sm tracking-wide cursor-pointer border-0 transition-all mt-9" style="background: #E8541A;" onmouseover="this.style.background='#C04E25'" onmouseout="this.style.background='#E8541A'">
                {{ cta_final.button_text if cta_final.button_text else "PLAN MY VISIT" }}
            </button>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- Footer -->
    {%- include "footer.njk" -%}

    <!-- Plan Your Visit Modal -->
    <div id="visit-modal-overlay" onclick="handleOverlayClick(event)">
        <div id="visit-modal-card">
            <button onclick="closeVisitModal()" style="position:absolute;top:16px;right:20px;font-size:28px;line-height:1;color:#9ca3af;background:none;border:none;cursor:pointer;padding:0;" aria-label="Close">&times;</button>
            <h2 class="font-anton text-3xl uppercase tracking-h2 mb-2" style="color:#1B2A4A;">Plan Your Visit</h2>
            <p class="text-gray-500 text-sm mb-6 leading-relaxed">We would love to know you are coming. Fill out this short form and we will make sure you are welcomed when you arrive.</p>
            <link href="//cdn-images.mailchimp.com/embedcode/classic-061523.css" rel="stylesheet" type="text/css">
            <div id="mc_embed_visit">
                <form action="https://mercycourt.us2.list-manage.com/subscribe/post?u=1f6d34239bf35c1b0512b77c8&amp;id=888af1f4b9&amp;f_id=0065c5e1f0" method="post" id="mc-visit-plan-form" name="mc-visit-plan-form" class="validate" target="_blank">
                    <div id="mc_visit_signup_scroll">
                        <div class="mc-field-group">
                            <label for="mce-FNAME-v">First Name <span class="asterisk">*</span></label>
                            <input type="text" name="FNAME" class="required text" id="mce-FNAME-v" required value="">
                        </div>
                        <div class="mc-field-group">
                            <label for="mce-LNAME-v">Last Name</label>
                            <input type="text" name="LNAME" class="text" id="mce-LNAME-v" value="">
                        </div>
                        <div class="mc-field-group">
                            <label for="mce-EMAIL-v">Email Address <span class="asterisk">*</span></label>
                            <input type="email" name="EMAIL" class="required email" id="mce-EMAIL-v" required value="">
                        </div>
                        <div class="mc-field-group">
                            <label for="mce-PHONE-v">Phone Number</label>
                            <input type="text" name="PHONE" id="mce-PHONE-v" value="">
                        </div>
                        <div class="mc-field-group">
                            <label for="mce-MMERGE10-v">Anything you'd like us to know?</label>
                            <input type="text" name="MMERGE10" class="text" id="mce-MMERGE10-v" value="">
                        </div>
                        <div class="mc-field-group">
                            <label for="mce-group-hear">How did you hear about us?</label>
                            <select name="group[10562]" id="mce-group-hear">
                                <option value=""></option>
                                <option value="1">Friend or Family</option>
                                <option value="2">Social Media</option>
                                <option value="32">Facebook or Instagram ad</option>
                                <option value="64">Google search ad</option>
                                <option value="4">Google Search (organic)</option>
                                <option value="8">Drove Past the Church</option>
                                <option value="16">Other</option>
                            </select>
                        </div>
                        <div class="mc-field-group">
                            <label for="mce-group-with">Are you coming with friend(s) or family?</label>
                            <select name="group[10563]" id="mce-group-with">
                                <option value=""></option>
                                <option value="32">Just me</option>
                                <option value="64">With a friend</option>
                                <option value="128">With my spouse</option>
                                <option value="256">With family and/or children</option>
                            </select>
                        </div>
                        <div hidden><input type="hidden" name="tags" value="5993"></div>
                        <div id="mce-responses-v">
                            <div id="mce-error-response-v" style="display:none;"></div>
                            <div id="mce-success-response-v" style="display:none;"></div>
                        </div>
                        <div aria-hidden="true" style="position:absolute;left:-5000px;">
                            <input type="text" name="b_1f6d34239bf35c1b0512b77c8_888af1f4b9" tabindex="-1" value="">
                        </div>
                        <div class="clear">
                            <input type="submit" name="subscribe" id="mc-visit-submit" class="button" value="Plan My Visit">
                        </div>
                    </div>
                </form>
            </div>
            <div id="plan-visit-success" style="display:none; text-align:center; padding:40px 20px;">
                <p style="font-size:20px; color:#1B2A4A; font-weight:bold;">Thank you! We are so excited to meet you. {% if visit_thankyou %}{{ visit_thankyou }}{% else %}See you Sunday at 529 Walker Avenue, Baltimore, MD 21212. Service begins at 10:00 AM.{% endif %}</p>
            </div>
        </div>
    </div>

    <script>
        function openVisitModal() {
            document.getElementById('visit-modal-overlay').classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeVisitModal() {
            document.getElementById('visit-modal-overlay').classList.remove('active');
            document.body.style.overflow = '';
            document.getElementById('mc_visit_signup_scroll').style.display = '';
            document.getElementById('plan-visit-success').style.display = 'none';
            document.getElementById('mc-visit-plan-form').reset();
        }
        function handleOverlayClick(e) {
            if (e.target === document.getElementById('visit-modal-overlay')) closeVisitModal();
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeVisitModal();
        });
        document.getElementById('mc-visit-plan-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const fname = document.getElementById('mce-FNAME-v').value;
            const lname = document.getElementById('mce-LNAME-v').value;
            const email = document.getElementById('mce-EMAIL-v').value;
            const phone = document.getElementById('mce-PHONE-v').value;
            const message = document.getElementById('mce-MMERGE10-v').value;
            const hearSelect = document.querySelector('#mc-visit-plan-form [name="group[10562]"]');
            const howDidYouHearValue = hearSelect.value;
            // Send empty for IDs not yet created in Mailchimp; Formspree still gets the label
            const howDidYouHearMailchimp = ['32', '64'].includes(howDidYouHearValue) ? '' : howDidYouHearValue;
            const howDidYouHear = hearSelect.selectedIndex > 0 ? hearSelect.options[hearSelect.selectedIndex].text : '';
            const withSelect = document.querySelector('#mc-visit-plan-form [name="group[10563]"]');
            const comingWithValue = withSelect.value;
            const comingWith = withSelect.selectedIndex > 0 ? withSelect.options[withSelect.selectedIndex].text : '';
            fetch('https://formspree.io/f/xreddnbn', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ firstName: fname, lastName: lname, email: email, phone: phone, message: message, howDidYouHear: howDidYouHear, comingWith: comingWith })
            });
            const cbName = 'mc_cb_' + Date.now();
            const params = new URLSearchParams({
                'FNAME': fname, 'LNAME': lname, 'EMAIL': email, 'PHONE': phone,
                'MMERGE10': message, 'group[10562]': howDidYouHearMailchimp, 'group[10563]': comingWithValue,
                'tags': '5993', 'b_1f6d34239bf35c1b0512b77c8_888af1f4b9': '', 'c': cbName
            });
            window[cbName] = function() { delete window[cbName]; if (script.parentNode) script.parentNode.removeChild(script); };
            const script = document.createElement('script');
            script.src = 'https://mercycourt.us2.list-manage.com/subscribe/post-json?u=1f6d34239bf35c1b0512b77c8&id=888af1f4b9&f_id=0065c5e1f0&' + params.toString();
            document.body.appendChild(script);
            document.getElementById('mc_visit_signup_scroll').style.display = 'none';
            document.getElementById('plan-visit-success').style.display = 'block';
        });
    </script>
</body>
</html>
