    <!-- Giving Modal -->
    <div id="giving-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden" aria-modal="true" role="dialog">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeGivingModal()"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden" style="max-height: 90vh;">
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                <h2 class="font-anton text-xl uppercase tracking-tight">Give to Mercy Court</h2>
                <button onclick="closeGivingModal()" class="text-gray-400 hover:text-gray-700 transition" aria-label="Close">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div style="overflow-y: auto; max-height: calc(90vh - 65px);">
                <iframe
                    id="giving-iframe"
                    src=""
                    data-src="https://www.zeffy.com/en-US/embed/donation-form/general-giving-25"
                    allowpaymentrequest
                    style="width: 100%; height: 800px; border: none; display: block;"
                ></iframe>
            </div>
        </div>
    </div>

    <script>
        function openGivingModal() {
            const modal = document.getElementById('giving-modal');
            const iframe = document.getElementById('giving-iframe');
            if (!iframe.src || iframe.src === window.location.href) {
                iframe.src = iframe.dataset.src;
            }
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            var mc=document.querySelector('#giving-modal > div:last-child');if(mc){mc.classList.remove('animate');void mc.offsetWidth;mc.classList.add('animate');}
        }
        function closeGivingModal() {
            document.getElementById('giving-modal').classList.add('hidden');
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeGivingModal();
        });
    </script>
