    <!-- End Meta Pixel Code -->
</head>
<body class="font-lato bg-white text-gray-900">

    <!-- Navigation -->
    {% include "nav.njk" %}

    <!-- Hero Section -->
    <section class="relative overflow-hidden" style="height: 60vh; padding-top: 72px;">
        <div class="absolute inset-0">
            <img loading="lazy" src="{{ hero_image }}" alt="{{ hero_image_alt }}" class="w-full h-full object-cover" style="object-position: {{ hero_focal_x | default('50%', true) }} {{ hero_focal_y | default('50%', true) }};">
            <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/80"></div>
        </div>
        <div class="relative z-10 h-full flex items-end justify-center pb-12 px-6">
            <div class="max-w-3xl text-center">
                <span class="inline-block bg-brand-red text-white px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest mb-4">{{ category | capitalize }}</span>
                <h1 class="font-anton text-4xl md:text-5xl lg:text-6xl uppercase text-white leading-none" style="letter-spacing:0.01em;">
                    {{ title }}
                </h1>
            </div>
        </div>
    </section>

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-100 px-6 py-3">
        <div class="max-w-[860px] mx-auto">
            <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap" itemscope itemtype="https://schema.org/BreadcrumbList">
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a href="/" itemprop="item" class="hover:text-brand-red transition"><span itemprop="name">Home</span></a>
                    <meta itemprop="position" content="1">
                </li>
                <li aria-hidden="true" class="text-gray-300">/</li>
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <a href="/blog" itemprop="item" class="hover:text-brand-red transition"><span itemprop="name">Blog</span></a>
                    <meta itemprop="position" content="2">
                </li>
                <li aria-hidden="true" class="text-gray-300">/</li>
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="text-gray-700 font-medium truncate max-w-[260px] sm:max-w-xs md:max-w-sm lg:max-w-none">
                    <span itemprop="name">{{ title }}</span>
                    <meta itemprop="position" content="3">
                </li>
            </ol>
        </div>
    </nav>

    <!-- Share Icons — Mobile (shown below breadcrumb on <768px) -->
    <div class="post-share-mobile md:hidden bg-white px-6 py-3 border-b border-gray-100">
        <div class="max-w-[860px] mx-auto flex items-center gap-3">
            <span class="text-xs font-bold uppercase tracking-widest text-gray-400 shrink-0">Share</span>
                    <!-- Facebook -->
                    <a href="#" data-share="facebook" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                    <!-- LinkedIn -->
                    <a href="#" data-share="linkedin" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                    <!-- X -->
                    <a href="#" data-share="x" target="_blank" rel="noopener noreferrer" aria-label="Share on X" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.261 5.632 5.903-5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>
                    <!-- Email -->
                    <a href="#" data-share="email" aria-label="Share via Email" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </a>
                    <!-- Print -->
                    <button onclick="window.print()" aria-label="Print this article" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                    </button>
        </div>
    </div>

    <!-- Article: Share column + body -->
    <section class="bg-white pt-10 px-6 pb-0">
        <div class="max-w-[860px] mx-auto md:flex md:gap-8 md:items-start">

            <!-- Share Column — Desktop/tablet (hidden on mobile, sticky) -->
            <div class="post-share-col hidden md:flex flex-col items-center gap-3 pt-1" style="width:44px; position:sticky; top:96px; flex-shrink:0;">
                <span class="text-xs font-bold uppercase tracking-widest text-gray-400" style="writing-mode:vertical-rl; transform:rotate(180deg); letter-spacing:.15em; margin-bottom:4px;">Share</span>
                    <!-- Facebook -->
                    <a href="#" data-share="facebook" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                    <!-- LinkedIn -->
                    <a href="#" data-share="linkedin" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                    <!-- X -->
                    <a href="#" data-share="x" target="_blank" rel="noopener noreferrer" aria-label="Share on X" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.261 5.632 5.903-5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>
                    <!-- Email -->
                    <a href="#" data-share="email" aria-label="Share via Email" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </a>
                    <!-- Print -->
                    <button onclick="window.print()" aria-label="Print this article" class="flex items-center justify-center w-9 h-9 rounded-full text-gray-400 hover:text-[#D95A2B] hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#D95A2B] focus:ring-offset-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                    </button>
            </div>

            <!-- Main content column -->
            <div class="flex-1 min-w-0">

                <!-- Article Meta -->
                <div class="flex flex-wrap items-center gap-6 text-sm text-gray-500 border-b border-gray-100 pb-8 mb-0">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <span>{{ date | postDate }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        <span>{{ author }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>{{ read_time }} min read</span>
                    </div>
                </div>

                <!-- Article Body -->
                <article class="py-10">

                    {% if show_article_image and article_image and article_image_alt %}
                    <!-- Article image — stacked on mobile/tablet, floated on desktop -->
                    <div class="lg:hidden mb-6">
                        <img src="{{ article_image }}" alt="{{ article_image_alt }}" width="431" height="301" loading="eager" class="w-full rounded-xl shadow-md" style="aspect-ratio:431/301;object-fit:cover;object-position:{{ article_focal_x | default('50%', true) }} {{ article_focal_y | default('50%', true) }};">
                    </div>
                    <img src="{{ article_image }}" alt="{{ article_image_alt }}" width="431" height="301" loading="eager" class="post-article-img-float hidden lg:block float-right rounded-xl shadow-md mb-6 ml-8" style="max-width:431px;width:42%;aspect-ratio:431/301;object-fit:cover;object-position:{{ article_focal_x | default('50%', true) }} {{ article_focal_y | default('50%', true) }};">
                    {% endif %}

                    {{ content | safe }}

                    <div class="clear-both"></div>

                    {% if faq and faq.length %}
                    <div class="mt-12 bg-gray-50 rounded-lg p-8">
                        <h2>Frequently Asked Questions</h2>
                        <div class="space-y-6 mt-2">
                            {% for item in faq %}
                            <div class="{% if not loop.last %}border-b border-gray-100 pb-6{% endif %}">
                                <p style="font-weight: 700; color: #111827; margin-bottom: 0.5rem;">{{ item.question }}</p>
                                <p style="margin-bottom: 0;">{{ item.answer }}</p>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {% if scripture_references and scripture_references.length %}
                    <!-- Read Further -->
                    <div class="mt-12 bg-gray-50 border-l-4 border-brand-red rounded-r-lg p-8">
                        <h3 class="font-anton text-xl uppercase text-gray-900 tracking-tight mb-4">Read Further</h3>
                        <ul class="space-y-2 text-gray-600 text-lg" style="list-style: none; padding-left: 0;">
                            {% for ref in scripture_references %}
                            <li class="flex items-start gap-3">
                                <span class="text-brand-red font-bold mt-0.5">&#9679;</span>
                                <span>{{ ref }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    <!-- Back to Blog -->
