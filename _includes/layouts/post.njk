    <script src="/assets/js/analytics.js" defer></script>
    <style>[id]{scroll-margin-top:80px}</style>
    <style>
@keyframes modalIn{from{opacity:0;transform:scale(0.95) translateY(-8px)}to{opacity:1;transform:scale(1) translateY(0)}}
#giving-modal>div:last-child.animate{animation:modalIn 0.25s ease-out forwards}
@media(prefers-reduced-motion:reduce){ #giving-modal>div:last-child.animate{animation:none}}
article h2 {
    font-family: 'Anton', sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.875rem);
    text-transform: uppercase;
    color: #111827;
    letter-spacing: -0.025em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
}
article p {
    color: #4B5563;
    font-size: 1.125rem;
    line-height: 1.75rem;
    margin-bottom: 1.5rem;
}
article a {
    color: #D95A2B;
    text-decoration: none;
}
article a:hover {
    text-decoration: underline;
}
article ul, article ol {
    color: #4B5563;
    font-size: 1.125rem;
    line-height: 1.75rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
}
article ul { list-style-type: disc; }
article ol { list-style-type: decimal; }
article li { margin-bottom: 0.5rem; }
article blockquote {
    border-left: 4px solid #D95A2B;
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: #FFF8F5;
    color: #374151;
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.75rem;
}
article strong { color: #111827; font-weight: 700; }
    </style>
