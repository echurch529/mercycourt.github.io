<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set _seoTitle %}{% if "| Mercy Court" in seo_title or "| RCCG Mercy Court" in seo_title %}{{ seo_title }}{% else %}{{ seo_title }} | Mercy Court{% endif %}{% endset %}
    <title>{{ _seoTitle | safe }}</title>
    <meta name="description" content="{{ seo_description }}">
    <link rel="canonical" href="https://mercycourt.org{{ page.url | cleanUrl }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="RCCG Mercy Court">
    <meta property="og:title" content="{{ _seoTitle | safe }}">
    <meta property="og:description" content="{{ seo_description }}">
    <meta property="og:url" content="https://mercycourt.org{{ page.url | cleanUrl }}">
    <meta property="og:image" content="https://mercycourt.org{{ hero_image }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ _seoTitle | safe }}">
    <meta name="twitter:description" content="{{ seo_description }}">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-red': '#D95A2B',
                        'brand-dark': '#0A0A0A',
                        'brand-footer': '#1a1a1a',
                    },
                    fontFamily: {
                        'anton': ['Anton', 'sans-serif'],
                        'lato': ['Lato', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <script id="mcjs">!function(c,h,i,m,p){m=c.createElement(h),p=c.getElementsByTagName(h)[0],m.async=1,m.src=i,p.parentNode.insertBefore(m,p)}(document,"script","https://chimpstatic.com/mcjs-connected/js/users/1f6d34239bf35c1b0512b77c8/08dc922941bacce45fba209ed.js");</script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "description": {{ seo_description | dump | safe }},
      "url": "https://mercycourt.org{{ page.url | cleanUrl }}",
      "datePublished": "{{ date | isoDate }}",
      "dateModified": "{{ date | isoDate }}",
      "image": "https://mercycourt.org{{ hero_image }}",
      "author": {
        "@type": "Person",
        "name": {{ author | dump | safe }}
      },
      "publisher": {
        "@type": "Church",
        "name": "RCCG Mercy Court",
        "url": "https://mercycourt.org"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://mercycourt.org{{ page.url | cleanUrl }}"
      }
    }
    </script>
    {% if faq and faq.length %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in faq %}
        {
          "@type": "Question",
          "name": {{ item.question | dump | safe }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ item.answer | dump | safe }}
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
    </script>
    {% endif %}
    <!-- BreadcrumbList JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mercycourt.org/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://mercycourt.org/blog" },
        { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "https://mercycourt.org{{ page.url | cleanUrl }}" }
      ]
    }
    </script>
        <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JWGVNRLKJL"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JWGVNRLKJL');
    </script>
    <script src="/assets/js/analytics.js" defer></script>
    <style>[id]{scroll-margin-top:80px}</style>
    <style>
@keyframes modalIn{from{opacity:0;transform:scale(0.95) translateY(-8px)}to{opacity:1;transform:scale(1) translateY(0)}}
#giving-modal>div:last-child.animate{animation:modalIn 0.25s ease-out forwards}
@media(prefers-reduced-motion:reduce){ #giving-modal>div:last-child.animate{animation:none}}
article h2 {
    font-family: 'Anton', sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.875rem);
    text-transform: uppercase;
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
}
article h3 {
    font-family: 'Anton', sans-serif;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    text-transform: uppercase;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
}
article h4 {
    font-family: 'Lato', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #111827;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
}
article p {
    color: #4B5563;
    font-size: 1.125rem;
    line-height: 1.75rem;
    margin-bottom: 1.5rem;
}
article a {
    color: #D95A2B;
    text-decoration: none;
}
article a:hover {
    text-decoration: underline;
}
article ul, article ol {
    color: #4B5563;
    font-size: 1.125rem;
    line-height: 1.75rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
}
article ul { list-style-type: disc; }
article ol { list-style-type: decimal; }
article li { margin-bottom: 0.5rem; }
article blockquote {
    border-left: 4px solid #D95A2B;
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: #FFF8F5;
    color: #374151;
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.75rem;
}
article strong { color: #111827; font-weight: 700; }
@media print {
  nav, .post-share-col, .post-share-mobile, #post-give, #post-read-next, #post-newsletter, footer, #giving-modal { display: none !important; }
  body { background: white !important; }
  .post-article-img-float { float: none !important; width: 100% !important; margin: 0 0 1rem 0 !important; }
}
{% include "components/mc-styles.css.njk" %}
    </style>
    <!-- Meta Pixel Code -->
    <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js'); fbq('init', '1027268596866855'); fbq('track', 'PageView');</script>
