    <!-- Hero Section -->
    <section class="relative overflow-hidden" style="height: 60vh;">
        <div class="absolute inset-0">
            <img loading="lazy" src="{{ hero_image }}" alt="{{ hero_image_alt }}" class="w-full h-full object-cover" style="object-position: center;">
            <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/80"></div>
        </div>
        <div class="relative z-10 h-full flex items-end justify-center pb-12 px-6">
            <div class="max-w-3xl text-center">
                <span class="inline-block bg-brand-red text-white px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest mb-4">{{ category | capitalize }}</span>
                <h1 class="font-anton text-4xl md:text-5xl lg:text-6xl uppercase text-white tracking-tight leading-none">
                    {{ title }}
                </h1>
            </div>
        </div>
    </section>

    <!-- Article Meta -->
    <section class="bg-white pt-10 pb-4 px-6">
        <div class="max-w-3xl mx-auto flex flex-wrap items-center gap-6 text-sm text-gray-500 border-b border-gray-100 pb-8">
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span>{{ date | postDate }}</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                <span>{{ author }}</span>
            </div>
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>{{ read_time }} min read</span>
            </div>
        </div>
    </section>

    <!-- Article Body -->
    <article class="bg-white py-10 px-6">
        <div class="max-w-3xl mx-auto">

            {{ content | safe }}

            {% if scripture_references and scripture_references.length %}
            <!-- Read Further -->
            <div class="mt-12 bg-gray-50 border-l-4 border-brand-red rounded-r-lg p-8">
                <h3 class="font-anton text-xl uppercase text-gray-900 tracking-tight mb-4">Read Further</h3>
                <ul class="space-y-2 text-gray-600 text-lg">
                    {% for ref in scripture_references %}
                    <li class="flex items-start gap-3">
                        <span class="text-brand-red font-bold mt-0.5">&#9679;</span>
                        <span>{{ ref }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <!-- Back to Blog -->
            <div class="mt-12 pt-8 border-t border-gray-200 text-center">
                <a href="/blog" class="inline-block border-2 border-brand-dark text-brand-dark px-10 py-3 rounded-full font-bold uppercase text-sm hover:bg-brand-dark hover:text-white transition">
                    &larr; Back to Blog
                </a>
            </div>

        </div>
    </article>

    <!-- Give Section -->
    <section class="bg-white pt-24 pb-20 px-6">
