    <section class="bg-gray-50 py-16 px-6">
        <div class="container mx-auto max-w-3xl">
            <p class="text-xs font-bold uppercase tracking-widest mb-6" style="color: #E8541A;">Read Next</p>
            <div class="grid md:grid-cols-2 gap-6">
                {% for post in readNext %}
                <a href="{{ post.url | cleanUrl }}" class="group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300" style="border-radius: 12px;">
                    <div style="height: 160px; overflow: hidden;">
                        <img loading="lazy" src="{{ post.data.hero_image }}" alt="{{ post.data.hero_image_alt }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-5">
                        <span class="inline-block text-xs font-bold uppercase px-3 py-1 rounded-full mb-2" style="background-color: #FFF0EA; color: #E8541A;">{{ post.data.category | capitalize }}</span>
                        <h3 class="font-bold text-gray-900 leading-snug" style="font-size: 16px; color: #1B2A4A;">{{ post.data.title }}</h3>
                        <p class="text-brand-red font-bold text-sm mt-3">Read More &rarr;</p>
                    </div>
                </a>
                {% endfor %}
