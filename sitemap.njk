---
permalink: "/sitemap.xml"
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Core pages -->
  <url>
    <loc>https://mercycourt.org/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://mercycourt.org/about-us</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://mercycourt.org/plan-your-visit</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://mercycourt.org/contact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://mercycourt.org/give</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://mercycourt.org/watch-live</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://mercycourt.org/community-impact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <!-- Ministries -->
  <url>
    <loc>https://mercycourt.org/ministries</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://mercycourt.org/tehillah-voices</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://mercycourt.org/mercy-kidz</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <!-- Blog index -->
  <url>
    <loc>https://mercycourt.org/blog</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <!-- Blog posts (auto-generated; posts with draft: true are excluded) -->
  {%- for post in collections.posts %}
  {%- if not post.data.draft %}
  <url>
    <loc>https://mercycourt.org{{ post.url | cleanUrl }}</loc>
    <lastmod>{{ post.date | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endif %}
  {%- endfor %}
  <!-- Events (auto-generated; only pages with visible: true) -->
  {%- set visibleEvents = collections.eventPages | whereData("visible", true) %}
  {%- for event in visibleEvents %}
  <url>
    <loc>https://mercycourt.org/events/{{ event.data.slug }}</loc>
    <lastmod>{{ event.date | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- endfor %}
</urlset>
