---
templateEngineOverride: njk
layout: false
permalink: events/index.html
eleventyExcludeFromCollections: true
title: "Events | RCCG Mercy Court"
seo_description: "Upcoming and past events at RCCG Mercy Court in Baltimore, MD. Join us for services, campaigns, outreach and celebrations."
og_image: "https://mercycourt.org/assets/images/2026/congregation/congregation-worship-service-01.jpg"
hero:
  badge: "RCCG Mercy Court"
  title: "Events"
  subheading: "Upcoming campaigns, celebrations, and community gatherings."
  image: ""
  image_alt: ""
  focal_x: "50%"
  focal_y: "50%"
current_events:
  heading: "Current Events"
  intro: ""
fallback:
  heading: "Join Us Every Sunday"
  text: "9:30 AM \u2014 Morning Service\n529 Walker Avenue, Baltimore, MD 21212"
  button_label: "Plan Your Visit"
  button_url: "/plan-your-visit"
past_events:
  heading: "Past Events"
  intro: ""
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ seo_description }}">
    <link rel="canonical" href="https://mercycourt.org/events/">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="RCCG Mercy Court">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ seo_description }}">
    <meta property="og:url" content="https://mercycourt.org/events/">
    {%- if og_image %}
    {%- if 'https://' in og_image %}
    <meta property="og:image" content="{{ og_image }}">
    {%- else %}
    <meta property="og:image" content="https://mercycourt.org{{ og_image }}">
    {%- endif %}
    {%- endif %}
    <meta name="twitter:card" content="summary_large_image">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-red': '#D95A2B',
                        'brand-dark': '#0A0A0A',
                        'brand-footer': '#1a1a1a',
                    },
                    fontFamily: {
                        'anton': ['Anton', 'sans-serif'],
                        'lato': ['Lato', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JWGVNRLKJL"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-JWGVNRLKJL');
    </script>
    <script src="/assets/js/analytics.js" defer></script>
    <!-- Meta Pixel Code -->
    <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js'); fbq('init', '1027268596866855'); fbq('track', 'PageView');</script>
    <noscript><img height="1" width="1" src="https://www.facebook.com/tr?id=1027268596866855&ev=PageView&noscript=1"/></noscript>
    <!-- End Meta Pixel Code -->
    <style>{%- include "components/heading-tracking.njk" -%}</style>
</head>
<body class="font-lato bg-white text-gray-900">

    {%- include "nav.njk" -%}

    <!-- Hero -->
    <section class="relative overflow-hidden flex items-center justify-center text-white text-center" style="height: 55vh; min-height: 340px; {% if hero.image %}background-image: url('{{ hero.image }}'); background-size: cover; background-position: {{ hero.focal_x | default('50%') }} {{ hero.focal_y | default('50%') }};{% else %}background: #0A0A0A;{% endif %} padding-top: 72px;">
        {%- if hero.image %}<div class="absolute inset-0 bg-black/50"></div>{%- endif %}
        <div class="relative z-10 px-6">
            {%- if hero.badge %}<p class="text-brand-red text-xs font-bold uppercase tracking-widest mb-4">{{ hero.badge }}</p>{%- endif %}
            <h1 class="font-anton text-6xl md:text-8xl uppercase tracking-h1 leading-none mb-5">{{ hero.title if hero.title else "Events" }}</h1>
            {%- if hero.subheading %}<p class="text-white/60 text-lg max-w-xl mx-auto">{{ hero.subheading }}</p>{%- endif %}
        </div>
    </section>

    {%- set activeEvents = collections.eventPages | whereData("status", "active") | sortByDataKey("event_start_date", true) -%}
    {%- set pastEvents   = collections.eventPages | whereData("status", "past")   | sortByDataKey("event_start_date", false) -%}

    <!-- Current Events -->
    <section class="py-20 px-6">
        <div class="container mx-auto max-w-6xl">
            <h2 class="font-anton text-4xl md:text-5xl uppercase tracking-h2 text-gray-900 mb-3">{{ current_events.heading if current_events.heading else "Current Events" }}</h2>
            <div class="w-16 h-1 bg-brand-red {% if current_events.intro %}mb-4{% else %}mb-12{% endif %}"></div>
            {%- if current_events.intro %}<p class="text-gray-500 text-base leading-relaxed mb-12 max-w-2xl">{{ current_events.intro }}</p>{%- endif %}

            {% if activeEvents | length %}
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {% for event in activeEvents %}
                {%- set cardImg = event.data.card_image if event.data.card_image else (event.data.hero.image if event.data.hero else "") -%}
                <a href="/events/{{ event.data.slug }}/" class="group flex flex-col rounded-2xl overflow-hidden border border-gray-100 hover:shadow-xl transition-shadow duration-300">
                    {% if cardImg %}
                    <div class="aspect-video overflow-hidden bg-gray-100">
                        <img loading="lazy" src="{{ cardImg }}" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    </div>
                    {% else %}
                    <div class="aspect-video bg-brand-dark flex items-center justify-center">
                        <span class="font-anton text-2xl uppercase text-white/30 tracking-h2">{{ event.data.nav_label }}</span>
                    </div>
                    {% endif %}
                    <div class="flex flex-col flex-1 p-6">
                        <h3 class="font-anton text-xl uppercase tracking-h3 text-gray-900 mb-2 group-hover:text-brand-red transition-colors">{{ event.data.nav_label }}</h3>
                        {% if event.data.event_date %}
                        <p class="text-brand-red text-xs font-bold uppercase tracking-widest mb-3">{{ event.data.event_date }}</p>
                        {% endif %}
                        {% if event.data.card_summary %}
                        <p class="text-gray-500 text-sm leading-relaxed flex-1 mb-5">{{ event.data.card_summary }}</p>
                        {% else %}
                        <div class="flex-1"></div>
                        {% endif %}
                        <span class="inline-block self-start bg-brand-red text-white text-xs font-bold uppercase tracking-wide px-5 py-2 rounded-full group-hover:bg-[#C04E25] transition-colors">Learn More</span>
                    </div>
                </a>
                {% endfor %}
            </div>
            {% else %}
            <!-- No active events fallback -->
            <div class="max-w-2xl mx-auto text-center py-12 px-6 bg-gray-50 rounded-2xl">
                <p class="font-anton text-2xl uppercase tracking-h3 text-gray-700 mb-4">{{ fallback.heading if fallback.heading else "Join Us Every Sunday" }}</p>
                {%- if fallback.text %}
                <p class="text-gray-500 text-base leading-relaxed mb-8">{{ fallback.text | replace("\n", "<br>") | safe }}</p>
                {%- else %}
                <p class="text-gray-500 text-base leading-relaxed mb-2">9:30 AM — Morning Service</p>
                <p class="text-gray-500 text-base leading-relaxed mb-8">529 Walker Avenue, Baltimore, MD 21212</p>
                {%- endif %}
                <a href="{{ fallback.button_url if fallback.button_url else '/plan-your-visit' }}" class="inline-block bg-brand-red text-white text-xs font-bold uppercase tracking-wide px-8 py-3 rounded-full hover:bg-[#C04E25] transition mb-8">{{ fallback.button_label if fallback.button_label else "Plan Your Visit" }}</a>
                <p class="text-gray-400 text-sm mb-4">Follow us for upcoming events</p>
                <div class="flex gap-4 justify-center">
                    <a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-brand-red transition">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                    <a href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-brand-red transition">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                </div>
            </div>
            {% endif %}
        </div>
    </section>

    <!-- Past Events (hidden when empty) -->
    {% if pastEvents | length %}
    <section class="py-20 px-6 bg-gray-50">
        <div class="container mx-auto max-w-6xl">
            <h2 class="font-anton text-4xl md:text-5xl uppercase tracking-h2 text-gray-900 mb-3">{{ past_events.heading if past_events.heading else "Past Events" }}</h2>
            <div class="w-16 h-1 bg-brand-red {% if past_events.intro %}mb-4{% else %}mb-12{% endif %}"></div>
            {%- if past_events.intro %}<p class="text-gray-500 text-base leading-relaxed mb-12 max-w-2xl">{{ past_events.intro }}</p>{%- endif %}
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for event in pastEvents %}
                {%- set cardImg = event.data.card_image if event.data.card_image else (event.data.hero.image if event.data.hero else "") -%}
                <a href="/events/{{ event.data.slug }}/" class="group flex flex-col rounded-2xl overflow-hidden border border-gray-200 bg-white hover:shadow-lg transition-shadow duration-300">
                    {% if cardImg %}
                    <div class="aspect-video overflow-hidden bg-gray-100">
                        <img loading="lazy" src="{{ cardImg }}" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100 transition-opacity">
                    </div>
                    {% else %}
                    <div class="aspect-video bg-gray-200 flex items-center justify-center">
                        <span class="font-anton text-xl uppercase text-gray-400 tracking-h3">{{ event.data.nav_label }}</span>
                    </div>
                    {% endif %}
                    <div class="p-5">
                        <h3 class="font-anton text-lg uppercase tracking-h3 text-gray-800 mb-1 group-hover:text-brand-red transition-colors">{{ event.data.nav_label }}</h3>
                        {% if event.data.event_date %}
                        <p class="text-gray-400 text-xs uppercase tracking-widest">{{ event.data.event_date }}</p>
                        {% endif %}
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    {%- include "footer.njk" -%}

</body>
</html>
