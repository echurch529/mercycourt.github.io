<body class="font-lato bg-brand-dark text-white min-h-screen flex flex-col">

    <!-- Navigation -->
    <nav class="fixed top-0 w-full bg-black/90 backdrop-blur-sm z-50 py-4">
        <div class="container mx-auto px-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="/"><img loading="lazy" src="/assets/images/2026/branding/mercy-court-logo-white.png" alt="RCCG Mercy Court Logo" class="h-10 w-auto"></a>
            </div>
            <div class="hidden lg:flex items-center gap-6 text-xs uppercase font-medium text-white">
                <a href="/give" class="bg-brand-red px-5 py-2 rounded-full hover:bg-[#C04E25] transition">Give</a>
                <div class="relative group">
                    <a href="/about-us" class="hover:text-brand-red transition cursor-pointer flex items-center gap-1">
                        About Us
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </a>
                    <div class="absolute top-full left-0 mt-2 bg-black/95 backdrop-blur-sm rounded-lg py-2 min-w-[160px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                        <a href="/contact" class="block px-4 py-2 text-xs uppercase text-white/80 hover:text-brand-red hover:bg-white/5 transition">Contact</a>
                    </div>
                </div>
                <div class="relative group">
                    <a href="/ministries" class="hover:text-brand-red transition cursor-pointer flex items-center gap-1">
                        Ministries
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </a>
                    <div class="absolute top-full left-0 mt-2 bg-black/95 backdrop-blur-sm rounded-lg py-2 min-w-[180px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                        <a href="/tehillah-voices" class="block px-4 py-2 text-xs uppercase text-white/80 hover:text-brand-red hover:bg-white/5 transition">Tehillah Voices</a>
                        <a href="/mercy-kidz" class="block px-4 py-2 text-xs uppercase text-white/80 hover:text-brand-red hover:bg-white/5 transition">God's Heritage</a>
                    </div>
                </div>
                {%- set visibleEvents = collections.eventPages | whereData("visible", true) -%}
                {% if visibleEvents | length %}
                <div class="relative group">
                    <a href="/events/{{ visibleEvents[0].data.slug }}" class="hover:text-brand-red transition cursor-pointer flex items-center gap-1">
                        Events
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </a>
                    <div class="absolute top-full left-0 mt-2 bg-black/95 backdrop-blur-sm rounded-lg py-2 min-w-[180px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                        {% for event in visibleEvents %}
                        <a href="/events/{{ event.data.slug }}" class="block px-4 py-2 text-xs uppercase text-white/80 hover:text-brand-red hover:bg-white/5 transition">{{ event.data.nav_label }}</a>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                <a href="/community-impact" class="hover:text-brand-red transition">Community Impact</a>
                <a href="/watch-live" class="hover:text-brand-red transition">Watch Live</a>
                <a href="/blog" class="hover:text-brand-red transition">Blog</a>
            </div>
            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="lg:hidden text-white" aria-label="Open menu" onclick="document.getElementById('mobile-menu').classList.toggle('hidden'); this.setAttribute('aria-label', document.getElementById('mobile-menu').classList.contains('hidden') ? 'Open menu' : 'Close menu')">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden bg-black/95 backdrop-blur-sm mt-4 px-6 pb-6">
            <a href="/give" class="inline-block mb-3 bg-brand-red px-5 py-2 rounded-full text-xs uppercase font-medium text-white hover:bg-[#C04E25] transition">Give</a>
            <div>
                <a href="/about-us" class="block py-2 text-xs uppercase font-medium text-white hover:text-brand-red transition">About Us</a>
                <a href="/contact" class="block py-2 pl-4 text-xs uppercase font-medium text-white/70 hover:text-brand-red transition">Contact</a>
            </div>
            <div>
                <a href="/ministries" class="block py-2 text-xs uppercase font-medium text-white hover:text-brand-red transition">Ministries</a>
                <a href="/tehillah-voices" class="block py-2 pl-4 text-xs uppercase font-medium text-white/70 hover:text-brand-red transition">Tehillah Voices</a>
                <a href="/mercy-kidz" class="block py-2 pl-4 text-xs uppercase font-medium text-white/70 hover:text-brand-red transition">God's Heritage</a>
            </div>
            {% if visibleEvents | length %}
            <div>
                <a href="/events/{{ visibleEvents[0].data.slug }}" class="block py-2 text-xs uppercase font-medium text-white hover:text-brand-red transition">Events</a>
                {% for event in visibleEvents %}
                <a href="/events/{{ event.data.slug }}" class="block py-2 pl-4 text-xs uppercase font-medium text-white/70 hover:text-brand-red transition">{{ event.data.nav_label }}</a>
                {% endfor %}
            </div>
            {% endif %}
            <a href="/community-impact" class="block py-2 text-xs uppercase font-medium text-white hover:text-brand-red transition">Community Impact</a>
            <a href="/watch-live" class="block py-2 text-xs uppercase font-medium text-white hover:text-brand-red transition">Watch Live</a>
            <a href="/blog" class="block py-2 text-xs uppercase font-medium text-white hover:text-brand-red transition">Blog</a>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="pt-32 pb-16 px-6 text-center">
        <p class="text-brand-red text-xs font-bold uppercase tracking-widest mb-4">RCCG Mercy Court</p>
        <h1 class="font-anton text-5xl md:text-7xl uppercase tracking-tight mb-6">Events</h1>
        <p class="text-white/60 text-lg max-w-xl mx-auto">Special gatherings, campaigns, and celebrations at Mercy Court.</p>
    </section>

    <!-- Events Grid -->
    <main class="flex-1 container mx-auto px-6 pb-24">
        {% if visibleEvents | length %}
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
            {% for event in visibleEvents %}
            <a href="/events/{{ event.data.slug }}" class="group block bg-white/5 hover:bg-white/10 rounded-2xl overflow-hidden transition-all duration-200 border border-white/10 hover:border-brand-red/40">
                {% if event.data.hero and event.data.hero.image %}
                <div class="aspect-video overflow-hidden">
                    <img src="{{ event.data.hero.image }}" alt="{{ event.data.hero.image_alt or event.data.nav_label }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
                </div>
                {% endif %}
                <div class="p-6">
                    <p class="text-brand-red text-xs font-bold uppercase tracking-widest mb-2">Upcoming Event</p>
                    <h2 class="font-anton text-2xl uppercase tracking-tight text-white group-hover:text-brand-red transition-colors">{{ event.data.nav_label }}</h2>
                    {% if event.data.hero and event.data.hero.badge %}
                    <p class="text-white/50 text-sm mt-2">{{ event.data.hero.badge }}</p>
                    {% endif %}
                    <span class="inline-block mt-4 text-xs font-bold uppercase tracking-widest text-brand-red">Learn More →</span>
                </div>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <div class="text-center py-24 max-w-lg mx-auto">
            <p class="text-brand-red text-xs font-bold uppercase tracking-widest mb-4">Coming Soon</p>
            <h2 class="font-anton text-4xl uppercase tracking-tight mb-6">No Upcoming Events</h2>
            <p class="text-white/50 mb-10">We don't have any special events scheduled right now. Check back soon, or join us every Sunday at 10AM.</p>
            <a href="/plan-your-visit" class="inline-block bg-brand-red text-white px-8 py-3 rounded-full text-xs font-bold uppercase tracking-widest hover:bg-[#C04E25] transition">Plan Your Visit</a>
        </div>
        {% endif %}
    </main>

    <!-- Footer -->
    <footer class="bg-brand-footer border-t border-white/10 py-12 px-6">
        <div class="container mx-auto text-center">
            <a href="/"><img src="/assets/images/2026/branding/mercy-court-logo-white.png" alt="RCCG Mercy Court" class="h-10 w-auto mx-auto mb-6 opacity-80"></a>
            <p class="text-white/40 text-xs uppercase tracking-widest mb-2">529 Walker Avenue, Baltimore, MD 21212</p>
            <p class="text-white/40 text-xs uppercase tracking-widest mb-6">Sundays at 10:00 AM</p>
            <div class="flex justify-center gap-6 text-xs uppercase text-white/40 flex-wrap">
                <a href="/about-us" class="hover:text-white transition">About</a>
                <a href="/ministries" class="hover:text-white transition">Ministries</a>
                <a href="/community-impact" class="hover:text-white transition">Community Impact</a>
                <a href="/watch-live" class="hover:text-white transition">Watch Live</a>
                <a href="/give" class="hover:text-white transition">Give</a>
                <a href="/contact" class="hover:text-white transition">Contact</a>
            </div>
            <p class="text-white/20 text-xs mt-8">&copy; 2026 RCCG Mercy Court. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
