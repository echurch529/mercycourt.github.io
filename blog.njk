<body class="font-lato bg-white text-gray-900">

    <!-- Navigation -->
    {% include "nav.njk" %}

    <!-- Hero Banner -->
    <section class="relative h-[65vh] overflow-hidden" style="padding-top: 72px;">
        <div class="absolute inset-0">
            <img loading="lazy" src="{{ hero.image }}" alt="{{ hero.image_alt }}" class="w-full h-full object-cover" style="object-position: center 20%;">
            <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
        </div>
        <div class="relative z-10 h-full flex items-center justify-center text-center px-6">
            <div class="max-w-4xl">
                <h2 class="font-anton text-4xl md:text-5xl lg:text-7xl uppercase text-white tracking-tight leading-none mb-4">
                    {{ hero.headline }}<br><span class="text-brand-red">{{ hero.headline_highlight }}</span>
                </h2>
                <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
                    {{ hero.tagline }}
                </p>
            </div>
        </div>
    </section>

    <!-- Blog Section Label -->
    <section class="bg-white pt-16 pb-4 px-6">
        <div class="container mx-auto max-w-7xl">
            <div class="text-center mb-4">
                <div class="inline-flex items-center gap-2 mb-4">
                    <span class="w-8 h-[2px] bg-brand-red"></span>
                    <span class="text-brand-red text-xs uppercase font-bold tracking-widest">Blog</span>
                    <span class="w-8 h-[2px] bg-brand-red"></span>
                </div>
                <h2 class="font-anton text-4xl md:text-4xl uppercase tracking-tight">
                    {{ section.heading | safe }} <span class="text-brand-red">{{ section.heading_highlight }}</span>
                </h2>
                <p class="text-gray-500 text-lg mt-3 max-w-xl mx-auto">
                    {{ section.description }}
                </p>
            </div>
        </div>
    </section>

    <!-- Category Filter -->
    <section class="bg-white pb-8 px-6">
        <div class="container mx-auto max-w-7xl">
            <div class="flex flex-wrap justify-center gap-3">
                <button class="filter-btn bg-brand-red text-white px-6 py-2 rounded-full text-sm font-bold uppercase tracking-wide" data-category="all">All</button>
                <button class="filter-btn border-2 border-gray-300 text-gray-600 px-6 py-2 rounded-full text-sm font-bold uppercase tracking-wide hover:border-brand-red hover:text-brand-red transition" data-category="news">News</button>
                <button class="filter-btn border-2 border-gray-300 text-gray-600 px-6 py-2 rounded-full text-sm font-bold uppercase tracking-wide hover:border-brand-red hover:text-brand-red transition" data-category="events">Events</button>
                <button class="filter-btn border-2 border-gray-300 text-gray-600 px-6 py-2 rounded-full text-sm font-bold uppercase tracking-wide hover:border-brand-red hover:text-brand-red transition" data-category="inspiration">Inspiration</button>
            </div>
        </div>
    </section>

    {%- set featuredPost = collections.posts | where("data.featured", true) | first %}
    {%- if not featuredPost %}
    {%- set featuredPost = collections.posts | first %}
    {%- endif %}
    {%- set gridPosts = collections.posts | except(featuredPost.url) %}

    <!-- Featured Post -->
    <section id="featured-post" data-category="{{ featuredPost.data.category }}" class="bg-white pb-12 px-6">
        <div class="container mx-auto max-w-7xl">
            <div class="grid md:grid-cols-2 gap-0 rounded-xl overflow-hidden shadow-lg">
                <div class="relative h-[350px] md:h-[420px]">
                    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: #1a1a1a; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                        <img loading="lazy" src="{{ featuredPost.data.hero_image }}" alt="{{ featuredPost.data.hero_image_alt }}" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                    </div>
                    <div class="absolute top-4 left-4">
                        <span class="bg-brand-red text-white px-4 py-1 rounded-full text-xs font-bold uppercase">Featured</span>
                    </div>
                </div>
                <div class="bg-brand-dark p-10 md:p-12 flex flex-col justify-center">
                    <span class="text-brand-red text-xs font-bold uppercase tracking-widest mb-3">{{ featuredPost.date | postDate }}</span>
                    <h3 class="font-anton text-3xl md:text-4xl uppercase text-white tracking-tight mb-4 leading-tight">
                        {{ featuredPost.data.title }}
                    </h3>
                    <p class="text-gray-400 leading-relaxed mb-6">
                        {{ featuredPost.data.excerpt }}
                    </p>
                    <div class="flex items-center gap-4">
                        <a href="{{ featuredPost.url | cleanUrl }}" class="inline-block bg-brand-red text-white px-8 py-3 rounded-full font-bold uppercase text-sm hover:bg-[#C04E25] transition">
                            Read Article
                        </a>
                        <span class="text-gray-500 text-sm">{{ featuredPost.data.read_time }} min read</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="bg-gray-50 py-16 px-6">
        <div class="container mx-auto max-w-7xl">
            <div id="blog-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

                {%- for post in gridPosts %}
                <article data-category="{{ post.data.category }}" class="bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition group reveal">
                    <div class="relative overflow-hidden" style="height: 220px;">
                        <img loading="lazy" src="{{ post.data.hero_image }}" alt="{{ post.data.hero_image_alt }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position:{{ post.data.hero_focal_x | default('50%', true) }} {{ post.data.hero_focal_y | default('50%', true) }};" class="group-hover:scale-105 transition duration-500">
                        <div class="absolute top-4 left-4">
                            <span class="bg-brand-red text-white px-3 py-1 rounded-full text-[11px] font-bold uppercase">{{ post.data.category | capitalize }}</span>
                        </div>
                    </div>
                    <div class="p-6">
                        <span class="text-brand-red text-xs font-bold uppercase tracking-widest">{{ post.date | postDate }}</span>
                        <h3 class="font-anton text-xl uppercase mt-2 mb-3 tracking-tight leading-tight">
                            {{ post.data.title }}
                        </h3>
                        <p class="text-gray-500 text-sm leading-relaxed mb-4">
                            {{ post.data.excerpt }}
                        </p>
                        <a href="{{ post.url | cleanUrl }}" class="text-brand-red font-bold text-sm uppercase hover:underline">Read More &rarr;</a>
                    </div>
                </article>
                {%- endfor %}

            </div>
        </div>
    </section>

    <script>
      (function () {
        var buttons = document.querySelectorAll('.filter-btn');
        var featured = document.getElementById('featured-post');
        var cards = document.querySelectorAll('#blog-grid article[data-category]');

        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var cat = this.dataset.category;

            buttons.forEach(function (b) {
              b.classList.remove('bg-brand-red', 'text-white');
              b.classList.add('border-2', 'border-gray-300', 'text-gray-600');
            });
            this.classList.add('bg-brand-red', 'text-white');
            this.classList.remove('border-2', 'border-gray-300', 'text-gray-600');

            featured.style.display = (cat === 'all' || featured.dataset.category === cat) ? '' : 'none';

            cards.forEach(function (card) {
              card.style.display = (cat === 'all' || card.dataset.category === cat) ? '' : 'none';
            });
          });
        });
      })();
    </script>

    <!-- Subscribe / Stay Updated Section -->
    <section class="bg-brand-dark py-20 px-6">
        <div class="container mx-auto max-w-4xl text-center">
            <h2 class="font-anton text-4xl md:text-4xl uppercase text-white tracking-tight mb-4">
                Never Miss <span class="text-brand-red">An Update</span>
            </h2>
            <p class="text-gray-400 text-lg mb-8 max-w-xl mx-auto">
                Subscribe to our blog and get the latest news, devotionals, and community stories delivered straight to your inbox.
            </p>
            <div class="max-w-md mx-auto">
                <style>
                    #mc_embed_signup_dark { background: transparent; clear: left; width: 100%; overflow: visible; margin-bottom: 0; }
                    #mc_embed_signup_dark .mc-field-group { padding-bottom: 12px; width: 100%; }
                    #mc_embed_signup_dark input.email,
                    #mc_embed_signup_dark input.text {
                        width: 100%; padding: 12px 24px; border-radius: 9999px;
                        border: 2px solid rgba(255,255,255,0.3); background: transparent;
                        color: #ffffff; font-size: 14px; box-sizing: border-box;
                    }
                    #mc_embed_signup_dark input.email::placeholder,
                    #mc_embed_signup_dark input.text::placeholder { color: rgba(255,255,255,0.6); }
                    #mc_embed_signup_dark input.email:focus,
                    #mc_embed_signup_dark input.text:focus { outline: none; border-color: #ffffff; }
                    #mc_embed_signup_dark .clear { padding-top: 4px; }
                    #mc_embed_signup_dark input#mc-embedded-subscribe-dark {
                        width: 100%; padding: 12px 24px; height: 61px; border-radius: 9999px;
                        border: 2px solid transparent; background: #FFFFFF; color: #E8541A;
                        font-weight: 700; font-size: 14px; text-transform: uppercase;
                        letter-spacing: 0.05em; cursor: pointer; transition: background 0.2s;
                        text-align: center; line-height: 1; display: block; box-sizing: border-box; margin-bottom: 20px;
                    }
                    #mc_embed_signup_dark input#mc-embedded-subscribe-dark:hover { background: #f3f3f3; }
                    #mc_embed_signup_dark div#mce-responses { display: none; }
                </style>
                <div id="mc_embed_signup_dark">
                    <form action="https://mercycourt.us2.list-manage.com/subscribe/post?u=1f6d34239bf35c1b0512b77c8&id=888af1f4b9&f_id=0060c5e1f0" method="post" id="mc-embedded-subscribe-form-dark" name="mc-embedded-subscribe-form-dark" class="validate" target="_blank">
                        <div id="mc_embed_signup_scroll_dark">
                            <div class="mc-field-group"><input type="email" name="EMAIL" class="required email" id="mce-EMAIL-dark" required placeholder="Email Address"></div>
                            <div class="mc-field-group"><input type="text" name="FNAME" class="text" id="mce-FNAME-dark" placeholder="First Name"></div>
                            <div aria-hidden="true" style="position: absolute; left: -5000px;"><input type="text" name="b_1f6d34239bf35c1b0512b77c8_888af1f4b9" tabindex="-1" value=""></div>
                            <div class="clear"><input type="submit" name="subscribe" id="mc-embedded-subscribe-dark" class="button" value="Subscribe"></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Give Section -->
    <section class="bg-white pt-24 pb-20 px-6">
        <div class="container mx-auto max-w-4xl">
            <div class="border-l-4 border-brand-red pl-8">
                <h2 class="font-anton text-4xl md:text-4xl uppercase mb-4 tracking-tight">
                    Give to Mercy Court
                </h2>
                <p class="text-gray-600 text-lg mb-8">
                    Your generosity keeps blessing lives, thank you for giving.
                </p>
                <div class="flex flex-wrap gap-4">
                    <button onclick="openGivingModal()" class="inline-block border-2 border-brand-dark text-brand-dark px-8 py-3 rounded-full font-bold uppercase text-sm hover:bg-brand-dark hover:text-white transition cursor-pointer">
                        Give Now
                    </button>
                    <a href="/contact" class="inline-block bg-brand-red text-white px-8 py-3 rounded-full font-bold uppercase text-sm hover:bg-[#C04E25] transition">
                        Building Project
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Join Our Mailing List -->
    <section class="bg-brand-red py-16 px-6" style="padding-bottom: 60px;">
        <div class="container mx-auto max-w-2xl text-center">
            <h2 class="font-anton text-3xl md:text-4xl uppercase mb-4 text-white tracking-tight">
                JOIN OUR MAILING LIST
            </h2>
            <p class="text-white/80 text-sm mb-8">
                We promise not to spam you, but send you edifying and amazing
                content regularly from RCCG Mercy Court.
            </p>
            <div class="max-w-md mx-auto">
                <link href="//cdn-images.mailchimp.com/embedcode/classic-061523.css" rel="stylesheet" type="text/css">
                <style>
                    #mc_embed_signup { background: transparent; clear: left; width: 100%; overflow: visible; margin-bottom: 0; }
                    #mc_embed_signup_scroll { padding-bottom: 40px; }
                    #mc_embed_signup .mc-field-group { padding-bottom: 12px; width: 100%; }
                    #mc_embed_signup input.email, #mc_embed_signup input.text {
                        width: 100%; padding: 12px 24px; border-radius: 9999px;
                        border: 2px solid rgba(255,255,255,0.3); background: transparent;
                        color: #ffffff; font-size: 14px; box-sizing: border-box;
                    }
                    #mc_embed_signup input.email::placeholder,
                    #mc_embed_signup input.text::placeholder { color: rgba(255,255,255,0.6); }
                    #mc_embed_signup input.email:focus,
                    #mc_embed_signup input.text:focus { outline: none; border-color: #ffffff; }
                    #mc_embed_signup .clear { padding-top: 4px; }
                    #mc_embed_signup input#mc-embedded-subscribe {
                        width: 100%; padding: 12px 24px; height: 61px; border-radius: 9999px;
                        border: 2px solid transparent; background: #FFFFFF; color: #E8541A;
                        font-weight: 700; font-size: 14px; text-transform: uppercase;
                        letter-spacing: 0.05em; cursor: pointer; transition: background 0.2s;
                        text-align: center; line-height: 1; display: block; box-sizing: border-box; margin-bottom: 20px;
                    }
                    #mc_embed_signup input#mc-embedded-subscribe:hover { background: #f3f3f3; }
                    #mc_embed_signup div#mce-responses { display: none; }
                </style>
                <div id="mc_embed_shell">
                    <div id="mc_embed_signup">
                        <form action="https://mercycourt.us2.list-manage.com/subscribe/post?u=1f6d34239bf35c1b0512b77c8&id=888af1f4b9&f_id=0060c5e1f0" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate" target="_blank">
                            <div id="mc_embed_signup_scroll">
                                <div class="mc-field-group"><input type="email" name="EMAIL" class="required email" id="mce-EMAIL" required placeholder="Email Address"></div>
                                <div class="mc-field-group"><input type="text" name="FNAME" class="text" id="mce-FNAME" placeholder="First Name"></div>
                                <div aria-hidden="true" style="position: absolute; left: -5000px;"><input type="text" name="b_1f6d34239bf35c1b0512b77c8_888af1f4b9" tabindex="-1" value=""></div>
                                <div class="clear"><input type="submit" name="subscribe" id="mc-embedded-subscribe" class="button" value="Subscribe"></div>
                            </div>
                        </form>
                    </div>
                </div>
                <script type="text/javascript" src="//s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js"></script>
            </div>
        </div>
    </section>

    <!-- Footer -->
    {%- include "footer.njk" -%}

    <!-- Giving Modal -->
    <div id="giving-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden" aria-modal="true" role="dialog">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" onclick="closeGivingModal()"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden" style="max-height: 90vh;">
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                <h2 class="font-anton text-xl uppercase tracking-tight">Give to Mercy Court</h2>
                <button onclick="closeGivingModal()" class="text-gray-400 hover:text-gray-700 transition" aria-label="Close">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div style="overflow-y: auto; max-height: calc(90vh - 65px);">
                <iframe id="giving-iframe" src="" data-src="https://www.zeffy.com/en-US/embed/donation-form/general-giving-25" allowpaymentrequest style="width: 100%; height: 800px; border: none; display: block;"></iframe>
            </div>
        </div>
    </div>

    <script>
        function openGivingModal() {
            const modal = document.getElementById('giving-modal');
            const iframe = document.getElementById('giving-iframe');
            if (!iframe.src || iframe.src === window.location.href) { iframe.src = iframe.dataset.src; }
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            var mc=document.querySelector('#giving-modal > div:last-child');if(mc){mc.classList.remove('animate');void mc.offsetWidth;mc.classList.add('animate');}
        }
        function closeGivingModal() {
            document.getElementById('giving-modal').classList.add('hidden');
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeGivingModal(); });
    </script>
    <script>
(function(){var obs=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){entry.target.classList.add('visible');obs.unobserve(entry.target);}});},{threshold:0.12});document.querySelectorAll('.reveal').forEach(function(el){obs.observe(el);});})();
    </script>
</body>
</html>
