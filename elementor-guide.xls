<!-- SECTION I: REPORTING DASHBOARD -->
<tr class="section-header"><td colspan="11" style="background-color:#0A0A0A; color:#FFFFFF; font-weight:bold;">SECTION I: REPORTING DASHBOARD</td></tr>

<tr style="background-color:#D95A2B; color:#FFFFFF;">
<th colspan="3">Report</th><th colspan="3">Source / Tool</th><th colspan="2">Frequency</th><th colspan="3">Key Metrics</th>
</tr>

<tr>
<td colspan="3">Traffic Overview</td>
<td colspan="3">Google Analytics 4</td>
