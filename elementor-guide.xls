<style>
  table { border-collapse: collapse; width: 100%; }
  td, th { border: 1px solid #ccc; padding: 6px 10px; vertical-align: top; font-family: Calibri, sans-serif; font-size: 11pt; }
  th { background-color: #D95A2B; color: white; font-weight: bold; text-align: left; }
  .section-header { background-color: #0A0A0A; color: white; font-weight: bold; }
